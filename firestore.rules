rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProfile(uid) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt',
          'phoneNumber', 'profileCompleted'
        ])
        && data.uid is string && data.uid == uid
        && data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.get('profileCompleted', false) is bool
        && (!data.get('profileCompleted', false) || (
          data.displayName.size() >= 2
          && data.displayName.matches('.*[^[:space:]].*[^[:space:]].*')
        ))
        && (data.get('phoneNumber', null) == null || (
          data.phoneNumber is string
          && data.phoneNumber.matches('^[+]?[0-9]{7,15}$')
        ))
        && data.email is string && data.email.size() <= 320
        && data.email == request.auth.token.email
        && (data.photoUrl == null || (
          data.photoUrl is string && data.photoUrl.size() <= 2048
          && data.photoUrl.matches('https://.*')
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    match /users/{uid} {
      // Profil sendiri dapat dibaca langsung; listing collection ditolak.
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid) && validProfile(uid)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && validProfile(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && (!resource.data.get('profileCompleted', false)
          || request.resource.data.get('profileCompleted', false) == true)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'email', 'photoUrl', 'updatedAt',
            'phoneNumber', 'profileCompleted']);
      allow delete: if false;
    }

    function profileReady() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileCompleted == true;
    }

    function activeMember(companyId) {
      return profileReady()
        && get(/databases/$(database)/documents/company_access/$(request.auth.uid)).data.companyId == companyId
        && get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.role in ['manager', 'finance'];
    }

    function manager(companyId) {
      return activeMember(companyId)
        && get(/databases/$(database)/documents/companies/$(companyId)).data.status == 'active'
        && get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.role == 'manager';
    }

    function validCompany() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'businessType', 'bookkeepingStartDate',
          'address', 'phoneNumber', 'email', 'logoUrl', 'currency', 'createdBy',
          'status', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['name', 'businessType', 'bookkeepingStartDate',
          'address', 'phoneNumber', 'email', 'logoUrl', 'currency', 'createdBy',
          'status', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 100
        && d.name.matches('.*[^[:space:]].*[^[:space:]].*')
        && d.businessType in ['Dagang', 'Jasa', 'Manufaktur', 'Lainnya']
        && d.bookkeepingStartDate is timestamp
        && d.bookkeepingStartDate >= timestamp.date(1900, 1, 1)
        && d.bookkeepingStartDate < timestamp.date(2101, 1, 1)
        && d.address is string && d.address.size() <= 500
        && d.phoneNumber is string && (d.phoneNumber == '' || d.phoneNumber.matches('^[+]?[0-9]{7,15}$'))
        && d.email is string && d.email.size() <= 320
        && (d.email == '' || d.email.matches('^[^[:space:]@]+@[^[:space:]@]+[.][^[:space:]@]+$'))
        && (d.logoUrl == null || (d.logoUrl is string && d.logoUrl.size() <= 2048 && d.logoUrl.matches('https://[^/]+.*')))
        && d.currency == 'IDR' && d.status == 'active'
        && d.createdBy == request.auth.uid
        && d.createdAt == request.time && d.updatedAt == request.time;
    }

    // Referensi satu perusahaan per akun, terpisah dari profil yang dapat diedit.
    // Link tidak bisa dipindah/dihapus oleh client.
    match /company_access/{uid} {
      allow get: if isOwner(uid);
      allow list, update, delete: if false;
      allow create: if isOwner(uid) && profileReady()
        && request.resource.data.keys().hasAll(['uid', 'companyId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'companyId', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.companyId is string
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId)/members/$(uid)).data.uid == uid
        && getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId)/members/$(uid)).data.status == 'active';
    }

    match /companies/{companyId} {
      allow get: if activeMember(companyId) && resource.data.status == 'active';
      allow list, update, delete: if false;
      // ID creator deterministik; seluruh bootstrap harus dalam commit yang sama.
      allow create: if profileReady() && companyId == request.auth.uid
        && !exists(/databases/$(database)/documents/company_access/$(request.auth.uid))
        && validCompany()
        && getAfter(/databases/$(database)/documents/company_access/$(request.auth.uid)).data.companyId == companyId
        && getAfter(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.role == 'manager'
        && getAfter(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.status == 'active';

      match /members/{uid} {
        allow get: if isOwner(uid) || manager(companyId);
        allow list: if manager(companyId);
        allow update, delete: if false;
        allow create: if isOwner(uid) && profileReady()
          && !exists(/databases/$(database)/documents/company_access/$(uid))
          && request.resource.data.keys().hasAll(['uid', 'role', 'status', 'joinedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.status == 'active'
          && request.resource.data.joinedAt == request.time
          && getAfter(/databases/$(database)/documents/company_access/$(uid)).data.companyId == companyId
          && ((bootstrapManager(companyId, uid)) || (invitedFinance(companyId, uid)));
      }

      // Chart of Accounts terisolasi per perusahaan. Finance hanya membaca;
      // Manager menyiapkan akun. Edit/hapus belum tersedia agar identitas akun stabil.
      match /chart_of_accounts/{code} {
        allow get, list: if activeMember(companyId)
          && get(/databases/$(database)/documents/companies/$(companyId)).data.status == 'active';
        allow create: if manager(companyId) && validChartAccount(companyId, code);
        allow update, delete: if false;
      }
    }

    function validChartAccount(companyId, code) {
      let d = request.resource.data;
      let prefix = d.type == 'asset' ? '1' : d.type == 'liability' ? '2'
        : d.type == 'equity' ? '3' : d.type == 'revenue' ? '4' : '5';
      let groupCode = prefix + '000';
      return d.keys().hasAll(['code', 'name', 'type', 'normalBalance', 'parentCode',
          'isPosting', 'isActive', 'createdBy', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['code', 'name', 'type', 'normalBalance', 'parentCode',
          'isPosting', 'isActive', 'createdBy', 'createdAt', 'updatedAt'])
        && d.code == code && code.matches('^' + prefix + '[0-9]{3}$')
        && d.type in ['asset', 'liability', 'equity', 'revenue', 'expense']
        && d.normalBalance == (d.type in ['asset', 'expense'] ? 'debit' : 'credit')
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 100
        && d.name.matches('^[^[:space:]]([^\\r\\n\\t]*[^[:space:]])$')
        && d.isPosting is bool && d.isActive == true
        && d.createdBy == request.auth.uid
        && d.createdAt == request.time && d.updatedAt == request.time
        && ((code == groupCode && d.parentCode == null && !d.isPosting)
          || (code != groupCode && d.isPosting && d.parentCode == groupCode
            && getAfter(/databases/$(database)/documents/companies/$(companyId)/chart_of_accounts/$(groupCode)).data.type == d.type
            && getAfter(/databases/$(database)/documents/companies/$(companyId)/chart_of_accounts/$(groupCode)).data.isPosting == false
            && getAfter(/databases/$(database)/documents/companies/$(companyId)/chart_of_accounts/$(groupCode)).data.isActive == true));
    }

    function bootstrapManager(companyId, uid) {
      return request.resource.data.keys().hasOnly(['uid', 'role', 'status', 'joinedAt'])
        && request.resource.data.role == 'manager' && companyId == uid
        && !exists(/databases/$(database)/documents/companies/$(companyId))
        && getAfter(/databases/$(database)/documents/companies/$(companyId)).data.createdBy == uid
        && getAfter(/databases/$(database)/documents/companies/$(companyId)).data.status == 'active';
    }

    function verifiedRecipient(data) {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == data.email;
    }

    function invitedFinance(companyId, uid) {
      let id = request.resource.data.invitationId;
      let before = get(/databases/$(database)/documents/company_invitations/$(id)).data;
      let after = getAfter(/databases/$(database)/documents/company_invitations/$(id)).data;
      return request.resource.data.keys().hasOnly(['uid', 'role', 'status', 'joinedAt', 'invitationId'])
        && request.resource.data.role == 'finance'
        && id is string && before.companyId == companyId && before.role == 'finance'
        && before.status == 'pending' && verifiedRecipient(before)
        && after.status == 'accepted' && after.acceptedBy == uid
        && get(/databases/$(database)/documents/companies/$(companyId)).data.status == 'active';
    }

    function validInvitation() {
      let d = request.resource.data;
      return d.keys().hasAll(['companyId', 'companyName', 'email', 'role',
          'status', 'createdBy', 'createdAt', 'updatedAt', 'acceptedBy'])
        && d.keys().hasOnly(['companyId', 'companyName', 'email', 'role',
          'status', 'createdBy', 'createdAt', 'updatedAt', 'acceptedBy'])
        && d.companyId is string && d.companyName is string
        && d.email is string && d.email.size() <= 320 && d.email == d.email.lower()
        && d.email.matches('^[^[:space:]@]+@[^[:space:]@]+[.][^[:space:]@]+$')
        && d.email != request.auth.token.email.lower()
        && d.role == 'finance' && d.status == 'pending' && d.acceptedBy == null
        && d.createdBy == request.auth.uid
        && d.createdAt == request.time && d.updatedAt == request.time
        && d.companyName == get(/databases/$(database)/documents/companies/$(d.companyId)).data.name;
    }

    match /company_invitations/{invitationId} {
      // Missing get untuk transaksi idempotensi; tidak membuka dokumen yang ada.
      allow get: if request.auth != null && (resource == null
        || manager(resource.data.companyId) || verifiedRecipient(resource.data));
      allow list: if manager(resource.data.companyId) || verifiedRecipient(resource.data);
      allow create: if profileReady() && validInvitation() && manager(request.resource.data.companyId);
      allow delete: if false;
      allow update: if request.auth != null && resource.data.status == 'pending'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'acceptedBy'])
        && ((manager(resource.data.companyId)
            && request.resource.data.status == 'cancelled'
            && request.resource.data.acceptedBy == null)
          || (verifiedRecipient(resource.data) && profileReady()
            && ((request.resource.data.status == 'rejected' && request.resource.data.acceptedBy == null)
              || (request.resource.data.status == 'accepted'
                && request.resource.data.acceptedBy == request.auth.uid
                && !exists(/databases/$(database)/documents/company_access/$(request.auth.uid))
                && getAfter(/databases/$(database)/documents/company_access/$(request.auth.uid)).data.companyId == resource.data.companyId
                && getAfter(/databases/$(database)/documents/companies/$(resource.data.companyId)/members/$(request.auth.uid)).data.role == 'finance'
                && getAfter(/databases/$(database)/documents/companies/$(resource.data.companyId)/members/$(request.auth.uid)).data.invitationId == invitationId))));
    }

    // Transaksi, ledger, dan collection lain tetap tertutup.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
